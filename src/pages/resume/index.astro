---
import { load } from 'js-yaml';
import Base from '../../layouts/Base.astro';
import raw from '../../data/resume.yaml?raw';

type Bullet = string | { text: string; hidden?: boolean };
type Block = string | { bullets: Bullet[] };
type Role = { role: string; dates?: string; content?: Block[] };
type Entry = {
  org?: string;
  href?: string;
  role?: string;
  dates?: string;
  hidden?: boolean;
  content?: Block[];
  roles?: Role[];
};
type Section = { title: string; hidden?: boolean; entries: Entry[]; note?: string };
type Resume = {
  name: string;
  url: string;
  contact: { label: string; href: string }[];
  summary: { title: string; paragraphs: string[] };
  sections: Section[];
};

const r = load(raw) as Resume;
const visible = <T extends { hidden?: boolean }>(xs: T[] = []) => xs.filter((x) => !x.hidden);
const bullets = (bs: Bullet[]) =>
  bs.flatMap((b) => (typeof b === 'string' ? [b] : b.hidden ? [] : [b.text]));
// External links in the content open in a new tab, as they did on the old page.
const html = (s: string) => s.replace(/<a href="(https?:)/g, '<a target="_blank" rel="noopener" href="$1');
const title = 'Owen Wang · Resume';
---

<Base bare title={title} description="Owen Wang's resume">
  <article class="resume">
    <header class="head">
      <div>
        <h1><a href={r.url}>{r.name}</a></h1>
        <ul class="contact">
          {r.contact.map((c) => <li><a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.label}</a></li>)}
        </ul>
      </div>
      <button type="button" class="print-btn" onclick="window.print()">Save as PDF</button>
    </header>

    <section>
      <h2>{r.summary.title}</h2>
      {r.summary.paragraphs.map((p) => <p set:html={html(p)} />)}
    </section>

    {
      visible(r.sections).map((section) => (
        <section>
          <h2>{section.title}</h2>
          {visible(section.entries).map((e) => (
            <div class="entry">
              {e.org && (
                <div class="line">
                  <h3>
                    {e.href ? <a href={e.href} target="_blank" rel="noopener">{e.org}</a> : e.org}
                    {e.role && <span class="role">{e.role}</span>}
                  </h3>
                  {e.dates && <span class="dates">{e.dates}</span>}
                </div>
              )}
              {(e.content ?? []).map((b) =>
                typeof b === 'string' ? <p set:html={html(b)} /> : <ul>{bullets(b.bullets).map((t) => <li set:html={html(t)} />)}</ul>,
              )}
              {(e.roles ?? []).map((role) => (
                <div class="sub">
                  <h4>
                    {role.role}
                    {role.dates && <span class="role-dates">{role.dates}</span>}
                  </h4>
                  {(role.content ?? []).map((b) =>
                    typeof b === 'string' ? <p set:html={html(b)} /> : <ul>{bullets(b.bullets).map((t) => <li set:html={html(t)} />)}</ul>,
                  )}
                </div>
              ))}
            </div>
          ))}
          {section.note && <p class="note">{section.note}</p>}
        </section>
      ))
    }
  </article>
</Base>

<style>
  /* Plain eggshell page like the original resume, not the blue site theme. */
  :global(body) {
    background: #f2ede9 url('/assets/bg_eggshell.jpg');
  }
  .resume {
    width: min(100% - 2 * var(--gutter), 46rem);
    margin: clamp(2rem, 6vw, 4rem) auto 4rem;
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--text);
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 5vw, 2.4rem);
    letter-spacing: 0.02em;
    margin: 0 0 0.35rem;
  }
  h1 a {
    color: var(--text);
    text-decoration: none;
  }
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .contact li {
    margin: 0;
  }
  .contact a {
    color: var(--muted);
  }
  .print-btn {
    flex: none;
    font: 500 0.85rem var(--sans);
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .print-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  section {
    margin-top: 2rem;
  }
  h2 {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
  }
  .entry + .entry {
    margin-top: 1.25rem;
  }
  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }
  h3,
  h4 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .role {
    font-weight: 400;
  }
  .role::before {
    content: ', ';
  }
  h4 {
    font-weight: 500;
  }
  .dates {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .sub {
    margin-top: 0.75rem;
  }
  /* Role dates sit next to the title so they don't stack under the company's dates. */
  .role-dates {
    margin-left: 0.6rem;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  p {
    margin: 0.4rem 0 0;
  }
  ul:not(.contact) {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
  }
  ul:not(.contact) li + li {
    margin-top: 0.25rem;
  }
  li::marker {
    color: var(--faint);
  }
  .note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-style: italic;
  }

  @media print {
    @page {
      size: letter;
      margin: 0.5in 0.55in;
    }
    .resume {
      width: auto;
      margin: 0;
      font-size: 9.5pt;
      line-height: 1.4;
      color: #000;
    }
    .print-btn {
      display: none;
    }
    h1 {
      font-size: 20pt;
    }
    h2 {
      color: #000;
    }
    section {
      margin-top: 1.1rem;
    }
    :global(body) {
      background: #fff;
    }
    /* Let long entries (Odeko) flow across pages; just keep headings with what follows. */
    .line,
    h4,
    h2 {
      break-after: avoid;
    }
    li,
    p {
      break-inside: avoid;
    }
    .resume :global(a),
    .contact a,
    .dates,
    .role-dates {
      color: #000 !important;
      text-decoration: none;
    }
  }
</style>
