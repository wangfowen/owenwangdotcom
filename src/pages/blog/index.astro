---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';
import { SECTIONS } from '../../site';

const s = SECTIONS.blog;
const posts = await getPosts('blog');
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<Base title={s.title} description={s.description} section="blog" feed={{ title: s.title, href: s.feed }}>
  <div class="container">
    <header class="page-header">
      <h1>{s.title}</h1>
      <p>{s.description}</p>
    </header>

    {
      years.map((year) => (
        <section class="year">
          <h2 class="eyebrow">{year}</h2>
          <ul>
            {posts
              .filter((p) => p.data.date.getUTCFullYear() === year)
              .map((p) => (
                <li>
                  <a href={`/blog/${p.id}`}>
                    <span class="title">
                      {p.data.title}
                      {p.data.draft && <span class="draft">Draft</span>}
                    </span>
                    {p.data.tagline && <span class="tagline">{p.data.tagline}</span>}
                  </a>
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date, { month: 'short', day: 'numeric' })}</time>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .page-header {
    margin: 0 0 3rem;
  }
  .page-header h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .page-header p {
    color: var(--muted);
    margin: 0;
  }
  .year {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .year h2 {
    margin: 0.35rem 0 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  li + li {
    margin-top: 0.9rem;
  }
  li a {
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }
  .title {
    color: var(--text);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  li a:hover .title {
    color: var(--accent);
  }
  /* Only visible in `npm run dev`; drafts aren't in production builds. */
  .draft {
    margin-left: 0.4rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 600 0.7rem var(--sans);
    vertical-align: middle;
  }
  .tagline {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }
  time {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--faint);
    white-space: nowrap;
  }
  @media (max-width: 34rem) {
    .year {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
