---
import { load } from 'js-yaml';
import Base from '../../layouts/Base.astro';
import raw from '../../data/menus.yaml?raw';

type Menu = { title: string; date: Date; image: string; link: string };
const menus = (load(raw) as Menu[]).sort((a, b) => +new Date(b.date) - +new Date(a.date));
---

<Base width="wide" title="cheff's table" description="Home made tasting menus that educate through food">
  <div class="container wide">
    <header class="page-header">
      <h1>cheff's table</h1>
      <p>Home cooked tasting menus that educate through food</p>
    </header>
    <ul class="menus">
      {
        menus.map((m) => (
          <li>
            <a href={m.link} {...(m.link.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
              <img src={m.image} alt="" loading="lazy" />
              <span class="title">{m.title}</span>
              <span class="year">{new Date(m.date).getUTCFullYear()}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page-header {
    margin: 0 0 3rem;
    text-align: center;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .page-header p {
    color: var(--muted);
    margin: 0;
  }
  .menus {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 2rem 1.5rem;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--text);
  }
  img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 0.5rem;
  }
  .title {
    font-size: 1.4rem;
    font-style: italic;
  }
  a:hover .title {
    color: var(--accent);
  }
  .year {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
