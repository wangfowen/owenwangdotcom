---
import Base from '../../layouts/Base.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import TravelMap from '../../components/TravelMap.astro';
import { getStops, legs, mapPoints, placeLine } from '../../lib/travel';
import { formatDate } from '../../lib/posts';
import { SECTIONS } from '../../site';

const s = SECTIONS.travel;
const stops = await getStops();
const chapters = legs(stops);
const best = stops.filter((p) => p.data.featured);
const points = await mapPoints(stops);

// Countries in the order they were first visited, with counts.
const countries = [...new Set(stops.map((p) => p.data.country))].map((c) => ({
  name: c,
  count: stops.filter((p) => p.data.country === c).length,
}));

const span = (a: Date, b: Date) => {
  const f = (d: Date) => formatDate(d, { month: 'short', day: 'numeric' });
  return `${f(a)} – ${f(b)}, ${b.getUTCFullYear()}`;
};
const first = stops[0]?.data.date;
const last = stops.at(-1)?.data.date;
---

<Base
  width="wide"
  title={s.title}
  description={s.description}
  section="travel"
  feed={{ title: s.title, href: s.feed }}
  image={best[0]?.data.image.src}
>
  <div class="container wide">
    <header class="page-header">
      <p class="eyebrow">A travelogue, one dish at a time</p>
      <h1>{s.title}</h1>
      <p class="lede">{s.description}</p>
      {
        first && last && (
          <p class="stats">
            <span>
              <b>{stops.length}</b> dishes
            </span>
            <span>
              <b>{countries.length}</b> countries
            </span>
            <span>{span(first, last)}</span>
          </p>
        )
      }
    </header>

    <TravelMap points={points} />

    <div class="filters" role="toolbar" aria-label="Filter by country">
      <button type="button" aria-pressed="true" data-country="">All <span>{stops.length}</span></button>
      {
        countries.map((c) => (
          <button type="button" aria-pressed="false" data-country={c.name}>
            {c.name} <span>{c.count}</span>
          </button>
        ))
      }
    </div>

    {
      best.length > 0 && (
        <section class="best" data-section="best">
          <h2 class="section-title">Best of</h2>
          <div class="best-row">
            {best.map((p) => (
              <PhotoCard
                large
                href={`/travel/${p.id}`}
                image={p.data.image}
                kicker={`No. ${p.n} · ${p.data.country}`}
                title={p.data.food}
                subtitle={placeLine(p.data)}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      chapters.map((leg, i) => (
        <section class="chapter" data-country={leg.country}>
          <header class="chapter-header">
            <span class="eyebrow">Chapter {i + 1}</span>
            <h2>{leg.country}</h2>
            <p>
              {leg.stops.length} {leg.stops.length === 1 ? 'dish' : 'dishes'} ·{' '}
              {span(leg.stops[0].data.date, leg.stops.at(-1)!.data.date)}
            </p>
          </header>
          <div class="grid">
            {leg.stops.map((p) => (
              <PhotoCard
                href={`/travel/${p.id}`}
                image={p.data.image}
                kicker={`No. ${p.n}`}
                title={p.data.food}
                subtitle={placeLine(p.data)}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')];
  const best = document.querySelector<HTMLElement>('[data-section="best"]');

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const country = btn.dataset.country || null;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      chapters.forEach((c) => (c.hidden = !!country && c.dataset.country !== country));
      if (best) best.hidden = !!country;
      document.dispatchEvent(new CustomEvent('travel:filter', { detail: { country } }));
    });
  }
</script>

<style>
  .page-header {
    max-width: 44rem;
    margin: 0 0 2.5rem;
  }
  .page-header .eyebrow {
    color: var(--accent);
    margin: 0;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.025em;
    margin: 0.3rem 0 1rem;
  }
  .lede {
    font-size: 1.2rem;
    color: var(--muted);
    margin: 0;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.5rem 0 0;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .stats b {
    color: var(--text);
    font-weight: 650;
  }

  .filters {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 1rem 0;
    margin-bottom: 1rem;
    background: var(--bg);
    scrollbar-width: none;
  }
  .filters button {
    flex: none;
    font: 500 0.85rem var(--sans);
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .filters button span {
    color: var(--faint);
    margin-left: 0.2rem;
  }
  .filters button[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .filters button[aria-pressed='true'] span {
    color: inherit;
    opacity: 0.6;
  }

  .section-title {
    font-size: 1.75rem;
    margin: 2rem 0 1.25rem;
  }
  .best-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 19rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }
  .best-row > :global(*) {
    scroll-snap-align: start;
  }

  .chapter {
    margin-top: 4rem;
  }
  .chapter-header {
    display: grid;
    gap: 0.2rem;
    margin-bottom: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .chapter-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.015em;
    margin: 0;
  }
  .chapter-header p {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 2rem 1.25rem;
  }
  @media (max-width: 30rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 0.75rem;
    }
  }
</style>
