---
/**
 * An image with an optional caption.
 *
 *   import pic from './images/my-post/pic.jpg'
 *   <Figure src={pic} caption="Optimized + responsive" />
 *   <Figure src="/blog/images/old.png" caption="Plain URLs work too" full />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { responsiveWidths } from '../lib/images';

interface Props {
  src: ImageMetadata | string;
  caption?: string;
  alt?: string;
  /** Break out of the text column. */
  full?: boolean;
  width?: number;
}
const { src, caption, alt = caption ?? '', full = false, width } = Astro.props;
---

<figure class:list={[{ full }]}>
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} width={width} loading="lazy" decoding="async" />
    ) : (
      <Image src={src} alt={alt} width={width} widths={responsiveWidths(src, full ? [720, 1200, 1800] : [480, 720, 1200])} sizes={full ? '(min-width: 72rem) 72rem, 100vw' : '(min-width: 650px) 650px, 100vw'} />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
