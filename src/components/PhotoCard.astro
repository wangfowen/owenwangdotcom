---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image?: ImageMetadata;
  title: string;
  kicker?: string;
  subtitle?: string;
  /** Larger card for "best of" rows. */
  large?: boolean;
  /** Extra attributes for filtering/map linking. */
  [key: `data-${string}`]: string | number | undefined;
}
const { href, image, title, kicker, subtitle, large = false, ...rest } = Astro.props;
const dataAttrs = Object.fromEntries(Object.entries(rest).filter(([k]) => k.startsWith('data-')));
---

<a class:list={['card', { large }]} href={href} {...dataAttrs}>
  <div class="frame">
    {
      image ? (
        <Image
          src={image}
          alt=""
          widths={large ? [400, 640, 900] : [320, 480, 720]}
          sizes={large ? '(min-width: 60rem) 28rem, 80vw' : '(min-width: 72rem) 17rem, (min-width: 40rem) 33vw, 50vw'}
          loading="lazy"
        />
      ) : (
        <div class="placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="text">
    {kicker && <span class="eyebrow">{kicker}</span>}
    <span class="title">{title}</span>
    {subtitle && <span class="subtitle">{subtitle}</span>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--text);
  }
  .frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--rule);
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .card:hover .frame :global(img) {
    transform: scale(1.03);
  }
  .placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--accent-soft), var(--rule));
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .title {
    font-size: 1.2rem;
    line-height: 1.2;
    font-weight: 600;
  }
  .large .title {
    font-size: 1.45rem;
  }
  .card:hover .title {
    color: var(--accent);
  }
  .subtitle {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .eyebrow {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .frame :global(img) {
      transition: none;
    }
  }
</style>
